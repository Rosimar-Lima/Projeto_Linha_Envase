# Configuracao da ponte ADS rodando DENTRO do TwinCAT/BSD (conexao local).
# Copie para a raiz do projeto como ".env".

# 0.0.0.0 deixa a IHM acessivel pelo navegador do host Windows (http://<ip-da-vm>:3000).
HOST=0.0.0.0
PORT=3000

# AMS Net ID da PROPRIA VM TwinCAT/BSD (o roteador local trata como loopback).
# Confirme com o comando `ads-netid` no TwinCAT/BSD, se disponivel.
ADS_TARGET_AMS_NET_ID=39.90.64.65.1.1
ADS_TARGET_PORT=851

ADS_POLL_INTERVAL_MS=200
